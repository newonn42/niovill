{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niovill",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niovill-db",
      "database_id": "ed5c4e93-b0f7-4f47-9e09-bf0e1633b363",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
